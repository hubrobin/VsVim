<Project>

  <PropertyGroup>
    <!-- Disable the preview warning when building -->
    <_NETCoreSdkIsPreview>false</_NETCoreSdkIsPreview>

    <LangVersion Condition="'$(Language)' == 'C#'">Latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The VSIX packaging tools must match the VSSDK targets which are imported from the
      Visual Studio installation performing the build. Visual Studio 2026 (18.x) targets
      pass new arguments (e.g. '-targetSdkVersion') which the 17.x tools reject -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" Condition="'$(VsVimProjectType)' == 'Vsix' AND '$(VisualStudioVersion)' &gt;= '18.0'" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" Condition="'$(VsVimProjectType)' == 'Vsix' AND '$(VisualStudioVersion)' &lt; '18.0'" />
  </ItemGroup>

  <Import 
    Project="$(MSBuildThisFileDirectory)References\Vs2019\Vs2019.Build.targets"
    Condition="'$(VsVimVisualStudioTargetVersion)' == '16.0' AND '$(VsVimProjectType)' != ''" />

  <Import 
    Project="$(MSBuildThisFileDirectory)References\Vs2022\Vs2022.Build.targets"
    Condition="'$(VsVimVisualStudioTargetVersion)' == '17.0' AND '$(VsVimProjectType)' != ''" />
</Project>
